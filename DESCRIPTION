Package: Bstergm
Type: Package
Title: Bayesian Separable Temporal Exponential Random Graph Models
Version: 0.2.0
Authors@R: c(
    person("Alberto", "Caimo",
           email = "alberto.caimo1@ucd.ie",
           role = c("aut", "cre")),
    person("Isabella", "Gollini",
           email = "isabella.gollini@ucd.ie",
           role = c("aut"))
